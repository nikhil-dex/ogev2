{
  "manifest_version": 3,
  "name": "OgeNotes — Study Toolbelt",
  "version": "0.2.0",
  "description": "Capture notes, save links, organize learning playlists and track study time with a floating study toolbelt.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "OgeNotes Study Toolbelt",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
